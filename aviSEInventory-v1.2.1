# Log function with logging levels
def log(message, level="info"):
    if level == "debug" and DEBUG_MODE:
        print(f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} [DEBUG]: {message}")
    elif level == "info":
        print(f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} [INFO]: {message}")

# Validate step value
def validate_step(step_value):
    log(f"Validating step value: {step_value}", level="debug")
    if step_value < 300:
        log("Warning: Step value too low. Setting step to 300.", level="debug")
        return 300
    if step_value % 300 != 0:
        adjusted_step = ((step_value // 300 + 1) * 300)
        log(f"Warning: Step value is not a multiple of 300. Adjusting to {adjusted_step}.", level="debug")
        return adjusted_step
    log(f"Step value validated: {step_value}", level="debug")
    return step_value

# Convert bps to Mbps
def convert_to_mbps(bits_per_second):
    log(f"Converting {bits_per_second} bits per second to Mbps", level="debug")
    try:
        result = round(float(bits_per_second) / 1000000, 2)
        log(f"Conversion result: {result} Mbps", level="debug")
        return result
    except (TypeError, ValueError):
        log(f"Invalid value for conversion: {bits_per_second}", level="debug")
        return "N/A"

# Retry mechanism
def retry_request(url, headers, retries=3):
    log(f"Making request to {url}", level="debug")
    attempt = 0
    wait_time = 2
    while attempt < retries:
        log(f"Attempt {attempt+1} of {retries}", level="debug")
        response = requests.get(url, headers=headers, verify=False)
        if response.status_code == 200:
            log("Request successful", level="debug")
            return response
        attempt += 1
        log(f"Request failed with status code {response.status_code}. Retry {attempt}/{retries}. Waiting {wait_time}s before retrying...", level="debug")
        time.sleep(wait_time)
        wait_time *= 2
    log(f"Error: Failed to retrieve data after {retries} attempts.", level="info")
    return None

# Fetch performance metrics for a given SE UUID
def fetch_performance_metrics(se_info):
    log(f"Fetching performance metrics for SE: {se_info[1]} (UUID: {se_info[0]})", level="info")
    se_uuid, se_name, se_ip, se_ip_type, power_state, se_connected, state, reason, version, health_score, csv_file_path, avi_fqdn, sid, csrft = se_info
    step = validate_step(api_step)

    url = f"https://{avi_fqdn}/api/analytics/metrics/serviceengine/{se_uuid}/?metric_id={metrics_string}&limit={api_limit}&step={step}"
    headers = {
        "X-Avi-Tenant": "admin",
        "X-Avi-Version": avi_version,
        "X-Csrftoken": csrft,
        "Cookie": f"avi-sessionid={sid}; csrftoken={csrft}"
    }
    response = retry_request(url, headers)

    if response is None or not response.text:
        log(f"Error: Failed to retrieve metrics for SE UUID: {se_uuid}", level="info")
        with open(csv_file_path, 'a', newline='') as csv_file:
            writer = csv.writer(csv_file)
            writer.writerow([avi_fqdn, se_name, se_uuid, se_ip, se_ip_type, power_state, se_connected, state, reason, version, health_score] + ['N/A'] * len(metrics.split(',')))
        return

    log(f"Parsing performance data for SE: {se_name}", level="debug")
    perf_data = response.json()
    metrics_values = []
    for metric in metrics.split(","):
        value = next((item['data'][0]['value'] for item in perf_data.get('series', []) if item['header']['name'] == metric), "N/A")
        if metric in ["se_if.avg_bandwidth", "se_if.max_peak_bandwidth"]:
            value = convert_to_mbps(value)
        metrics_values.append(str(value))

    log(f"Writing performance data for SE: {se_name} to CSV", level="debug")
    with open(csv_file_path, 'a', newline='') as csv_file:
        writer = csv.writer(csv_file)
        writer.writerow([avi_fqdn, se_name, se_uuid, se_ip, se_ip_type, power_state, se_connected, state, reason, version, health_score] + metrics_values)

# Log into the AVI controller
def avi_login(avi_fqdn):
    avi_user, avi_pass = credentials.get(avi_fqdn, (default_avi_user, default_avi_pass))
   
    log(f"Logging into controller: {avi_fqdn} with user: {avi_user}", level="info")
    login_url = f"https://{avi_fqdn}/login"
    response = requests.post(login_url, data={'username': avi_user, 'password': avi_pass}, verify=False)
    if response.status_code != 200:
        log(f"Error: Failed to login to controller: {avi_fqdn}", level="info")
        exit(1)

    cookies = response.cookies
    sid = cookies.get("avi-sessionid")
    csrft = cookies.get("csrftoken")
    if not sid or not csrft:
        log(f"Error: Failed to retrieve session ID or CSRF token for controller: {avi_fqdn}", level="info")
        exit(1)
    log(f"Logged into AVI Controller: {avi_fqdn} (Session ID: {sid})", level="info")
    return sid, csrft

# Main execution
