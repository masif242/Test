    #csv_file_name = f"{output_dir}/SEInventory-Report-{datetime.now().strftime('%Y-%m-%dT%H-%M-%S')}.csv"
    csv_file_name = f"/home/imallikarjun/scripts/reports/avi-SEInventory-{datetime.now().strftime('%Y%m%dT%H%M%S')}.csv"

    # Create the CSV file and write the headers once
    with open(csv_file_name, 'w', newline='') as csv_file:
        writer = csv.writer(csv_file)
        writer.writerow(["Controller", "SE Name", "SE UUID", "SE Management IPAddress", "IPAddress Type", "Power State", "Connected", "State", "Reason", "Version", "Health Score"] + metrics_headings.split(","))

    for avi_fqdn in controllers:
        log(f"Processing controller: {avi_fqdn}", level="info")
        sid, csrft = avi_login(avi_fqdn)

        log(f"Fetching Service Engine inventory from: {avi_fqdn}", level="info")
        inventory_url = f"https://{avi_fqdn}/api/serviceengine-inventory/"
        while inventory_url:
            inventory_response = retry_request(inventory_url, {
                "X-Avi-Tenant": "admin",
                "X-Avi-Version": avi_version,
                "X-Csrftoken": csrft,
                "Cookie": f"avi-sessionid={sid}; csrftoken={csrft}"
            })

            if not inventory_response or inventory_response.status_code != 200:
                log(f"Error: Failed to fetch inventory from {avi_fqdn}", level="info")
                break

            log(f"Parsing Service Engine inventory data from: {avi_fqdn}", level="debug")
            se_data = inventory_response.json()

            se_info_list = []
            for se in se_data.get('results', []):
                config = se.get('config', {})
                runtime = se.get('runtime', {})
                health = se.get('health_score', {})

                se_uuid = config.get('uuid', 'N/A')
                se_name = config.get('name', 'N/A')
                mgmt_ip_address = config.get('mgmt_ip_address', {})
                se_ip = mgmt_ip_address.get('addr', 'N/A')
                se_ip_type = mgmt_ip_address.get('type', 'N/A')
                power_state = runtime.get('power_state', 'N/A')
                se_connected = runtime.get('se_connected', 'N/A')
                oper_status = runtime.get('oper_status', {})
                state = oper_status.get('state', 'N/A')
                reason_list = oper_status.get('reason', [])
                reason = " ".join(reason_list) if reason_list else 'N/A'
                version = runtime.get('version', 'N/A')
                health_score = health.get('health_score', 'N/A')

                se_info = [
                    se_uuid, se_name, se_ip, se_ip_type, power_state, se_connected,
                    state, reason, version, health_score, csv_file_name, avi_fqdn, sid, csrft
                ]
                se_info_list.append(se_info)

            if enable_parallel_processing:
                log(f"Parallel processing enabled with {parallel_processes} processes.", level="info")
                with Pool(parallel_processes) as pool:
                    pool.map(fetch_performance_metrics, se_info_list)
            else:
                log("Parallel processing disabled. Processing sequentially.", level="info")
                for se_info in se_info_list:
                    fetch_performance_metrics(se_info)

            # Check for pagination, move to the next page if 'next' URL exists
            inventory_url = se_data.get('next', None)

    log(f"Report saved to file {csv_file_name}", level="info")
    log("Script completed.", level="info")

if __name__ == "__main__":
    main()
